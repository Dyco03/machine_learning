   "source": [
    "from sklearn.datasets import make_blobs\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "X, Y = make_blobs(\n",
    "    n_samples=200,\n",
    "    centers=3,        # 🔥 nombre de classes\n",
    "    n_features=2,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "plt.scatter(X[:,0], X[:,1], c=Y)\n",
    "plt.show()"
   ]
